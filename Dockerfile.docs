ARG BASE_IMAGE
FROM ${BASE_IMAGE}

COPY docs/.vitepress/dist/ /usr/share/nginx/html/
# Same file as meshsat.net's, one source to renew (MESHSAT-1699, as get.meshsat.net since MESHSAT-1186)
COPY site/static/.well-known/security.txt /usr/share/nginx/html/.well-known/security.txt
COPY nginx-docs.conf /etc/nginx/nginx.conf
COPY nginx-docs-headers.conf /etc/nginx/security-headers.conf
