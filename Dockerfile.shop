# shop.meshsat.net for the notrf01 cluster (MESHSAT-1521): the built shop site
# on nginx-unprivileged (non-root, port 8080), the same base the Hub's basemap
# serves from, pinned by digest (1.27-alpine, resolved 2026-09-08).
FROM docker.io/nginxinc/nginx-unprivileged@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0
COPY --chown=101:101 shop/public/ /usr/share/nginx/html/
COPY nginx-shop.conf /etc/nginx/nginx.conf
EXPOSE 8080
