# shop.meshsat.net for the notrf01 cluster (MESHSAT-1521): the built shop site
# on nginx-unprivileged (non-root, port 8080), pinned by digest (1.29-alpine,
# resolved 2026-10-11). `apk upgrade` first, so the image carries the fixes
# Alpine has published since the tag was cut: the trivy gate failed the first
# build on OpenSSL and c-ares fixes the 1.27 base from September lacked (the
# Hub's MESHSAT-1472 lesson).
FROM docker.io/nginxinc/nginx-unprivileged@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6
USER root
RUN apk upgrade --no-cache
USER 101
COPY --chown=101:101 shop/public/ /usr/share/nginx/html/
COPY nginx-shop.conf /etc/nginx/nginx.conf
EXPOSE 8080
